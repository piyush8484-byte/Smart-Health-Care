NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart-healthcare
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
EMAIL_VERIFICATION_SECRET=replace-with-a-third-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Smart Healthcare <no-reply@example.test>
UPLOAD_DIR=uploads
DEMO_PASSWORD=DemoPass123!
# Set these only when running `npm run admin:create` in the server workspace.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=