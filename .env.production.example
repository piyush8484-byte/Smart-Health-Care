NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongo:27017/smart-healthcare
CLIENT_ORIGIN=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret-at-least-32-characters
EMAIL_VERIFICATION_SECRET=replace-with-a-third-strong-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY=replace-with-32-char-key-example-123456
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=service@example.com
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM="Smart Healthcare <no-reply@example.com>"
UPLOAD_DIR=uploads
DEMO_PASSWORD=ReplaceWithStrongDemoPass123!
# Set these only for backend administrator provisioning. Never expose them to the client.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ReplaceWithAUniquePassword12!
# ADMIN_NAME=Platform Administrator
